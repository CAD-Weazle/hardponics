// setup GPIOs for Touch operation
void init_tcs (void)
{
  // enable Comparator interface clock to access RI registers
  RCC->APB1ENR |= RCC_APB1ENR_COMPEN;

  // no hysteresis on PB5 (& PB6, PB7, PB8???)
  RI->HYSCR1 = (1 << (5 + 16))  // add 16 for high word bits
             | (1 << (6 + 16))
             | (1 << (7 + 16))
             | (1 << (8 + 16));
 
  // set output value
  gpio_clr (GPIOB, 5);           // PB5 is zero
  gpio_clr (GPIOB, 6);           // PB6 is zero
  gpio_clr (GPIOB, 7);           // PB7 is zero
  gpio_clr (GPIOB, 8);           // PB8 is zero

  // ADC analog switches open !!! - st
  RI->ASCR1 &= (uint32_t)(~0x80000000); // ADC analog switches closed if the corresponding I/O switch is also closed (????)
  RI->ASCR2 &= (uint32_t)(~0b00011000000000000000000000110000);
  
//printf2 ("ASCR1: 0x%08x\n", RI->ASCR1); // ASCR1: 0x00000000
//printf2 ("ASCR2: 0x%08x\n", RI->ASCR2); // ASCR2: 0x00000000
}

// sampling capacitor discharge
void tsc_cs_discharge (void)
{
  // GPIO drive zero
  gpio_clr (GPIOB, 5);

  // GPIO to output
  int tmp = GPIOB->MODER;

  tmp &= ~(0b11 << (5*2));
  tmp |=  (0b01 << (5*2));

  GPIOB->MODER = tmp;
  
//printf2 ("MODER: 0x%08x\n", GPIOB->MODER);
}

// sampling capacitor floating
void tsc_cs_float (void)
{
  // GPIO to input
  int tmp = GPIOB->MODER;

  tmp &= ~(0b11 << (5*2));

  GPIOB->MODER = tmp;

}



// touch capacitor discharge
void tsc_ct_discharge (int num)
{
  // sanity check
  if (num >= 3)
    return;

  // GPIO to output - drive zero
  gpio_clr (GPIOB, soil_gpio[num]);           // PB6 is zero

  int tmp = GPIOB->MODER;

  tmp &= ~(0b11 << (soil_gpio[num]*2));
  tmp |=  (0b01 << (soil_gpio[num]*2));

  GPIOB->MODER = tmp;
}

// touch capacitor floating
void tsc_ct_float (int num)
{
  // GPIO input
  int tmp = GPIOB->MODER;

  tmp &= ~(3UL << (soil_gpio[num]*2)); // input

  GPIOB->MODER = tmp;
}

// touch capacitor charge
void tsc_ct_charge (int num)
{
  // GPIO output - drive one
  gpio_set (GPIOB, soil_gpio[num]);

  int tmp = GPIOB->MODER;

  tmp &= ~(0b11 << (soil_gpio[num]*2)); // clear all
  tmp |=  (0b01 << (soil_gpio[num]*2)); // output

  GPIOB->MODER = tmp;
}

// adjust analog switch network Routing Interface
void tcs_switches (int num)
{
  switch (num)
  {
    // select sampling cap & sensor SOIL0
    case 0:
    {
      RI->ASCR2 = (1 << 5) | (1 << 27);  // switches closed - PB5/PB6 (GRP6-2 / GR6-3)
      break;
    }

    // select sampling cap & sensor SOIL1
    case 1:
    {
      RI->ASCR2 = (1 << 5) | (1 << 28);  // switches closed - PB5/PB7 (GRP6-2 / GR6-4)
      break;
    }

    // select sampling cap & sensor SOIL2
    case 2:
    {
      RI->ASCR2 = (1 << 5) | (1 << 4);  // switches closed - PB5/PB4 (GRP6-2 / GR6-1)
      break;
    }

    default:	
       break;
  }
}

#define TCS_START    0
#define TCS_SAMPLE   1
#define TCS_CHECK    2

int soil_read (int sensor)
{
  static int tcs_state = TCS_START;
  static int cnt = 0;
 
  while (1)
  {
    switch (tcs_state)
    {
      case TCS_START:
      {
        cnt = 0;

        tsc_cs_discharge ();
        tsc_ct_discharge (sensor);
    
        usleep (500);
      }
 
      // float Ct & Cs    
      case TCS_SAMPLE:
      {
        tsc_cs_float ();
        tsc_ct_float (sensor);
    
        usleep (10);
    
        tsc_ct_charge (sensor);
        tsc_ct_float (sensor);
    
        tcs_switches (sensor);
      }

      // next round or terminate    
      case TCS_CHECK:
      {
        RI->ASCR2 = 0;    // all switches open
       
        if (GPIOB->IDR & (1 << 5))
        {
          tcs_state = TCS_START;

          return (cnt);
        }
        else
        {
          cnt++;
          tcs_state = TCS_SAMPLE;
        }
        break;
      }
    
      default:
        break;
    }
  }
}























