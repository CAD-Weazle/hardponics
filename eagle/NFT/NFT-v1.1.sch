<plain>
<text x="2.54" y="15.24" size="1.524" layer="97" font="fixed" ratio="10">* PINNING</text>
<text x="2.54" y="12.7" size="1.524" layer="97" font="fixed" ratio="10">* FUNCTIONALITY</text>
<text x="2.54" y="10.16" size="1.524" layer="97" font="fixed" ratio="10">* PHYSICAL SIZE</text>
<text x="2.54" y="5.08" size="1.524" layer="97" font="fixed" ratio="10">* LAID OUT</text>
<text x="2.54" y="2.54" size="1.524" layer="97" font="fixed" ratio="10">* COMPS IN LIB</text>
<text x="2.54" y="7.62" size="1.524" layer="97" font="fixed" ratio="10">* IN HOUSE</text>
<text x="114.808" y="8.636" size="1.778" layer="94">NFT Control - Power</text>
<text x="110.49" y="4.826" size="1.778" layer="94">220816</text>
<text x="133.35" y="4.826" size="1.778" layer="94">1.1</text>
<text x="24.13" y="15.24" size="1.524" layer="97" font="fixed" ratio="10">: NO (LT3652)</text>
<text x="24.13" y="2.54" size="1.524" layer="97" font="fixed" ratio="10">: OK</text>
<text x="3.048" y="25.654" size="4.318" layer="98">JLCPCB: "CUT STENCIL ACCORDING TO PASTE LAYER"</text>
<text x="135.636" y="208.026" size="1.27" layer="98" ratio="10">12V6/10Ah Li-ion battery pack (3x 4v2)</text>
<text x="24.13" y="12.7" size="1.524" layer="97" font="fixed" ratio="10">: NO (LT3652)</text>
<text x="24.13" y="10.16" size="1.524" layer="97" font="fixed" ratio="10">: NO (LT3652)</text>
<text x="24.13" y="7.62" size="1.524" layer="97" font="fixed" ratio="10">: OK</text>
<text x="24.13" y="5.08" size="1.524" layer="97" font="fixed" ratio="10">: OK</text>
<text x="75.184" y="134.112" size="1.27" layer="101" font="fixed" ratio="10" rot="MR0">&lt;&gt; TODO: AAN STM32 (SPEED0???)!!!! NC</text>
<text x="98.044" y="134.112" size="1.27" layer="98" ratio="10">0R005</text>
<text x="77.724" y="126.492" size="1.27" layer="98" ratio="10">x200 -&gt; 1V/A</text>
<text x="70.104" y="83.312" size="1.27" layer="98" ratio="10">hi-ESR ECAP</text>
<text x="110.744" y="68.072" size="1.27" layer="98" ratio="10">Vout = Vref * (1 + R2/R2) + Iadj*R2 = 4V6..4V8</text>
<text x="110.744" y="65.532" size="1.27" layer="98" ratio="10">R1 = 1K</text>
<text x="110.744" y="62.992" size="1.27" layer="98" ratio="10">R2 = 2K7</text>
<text x="110.744" y="60.452" size="1.27" layer="98" ratio="10">Vref = 1V25</text>
<text x="110.744" y="57.912" size="1.27" layer="98" ratio="10">Iadj = 70uA</text>
<text x="70.358" y="215.392" size="1.27" layer="101" ratio="10" rot="MR0">NC</text>
<text x="134.62" y="222.758" size="1.27" layer="98" ratio="10">Imax = 100mV/Rsense = 1A</text>
<text x="87.884" y="208.026" size="1.27" layer="98" ratio="10">Vfloat = 12Vx (calculate)</text>
<text x="50.8" y="230.378" size="1.27" layer="98" ratio="10">2V7 -&gt;</text>
<text x="2.54" y="224.028" size="1.27" layer="98" ratio="10">solar Voc = 16V (check this)</text>
<text x="113.538" y="215.392" size="1.27" layer="98" ratio="10">&lt;- 3V3</text>
<text x="76.2" y="199.39" size="1.27" layer="98" ratio="10">R01FB = (VBAT(FLT) * 2.5 * 10^5) / 3.3  (Ω)
      = (12V6 * 2.5 * 10^5) / 3.3
      = 954K5</text>
<text x="76.2" y="190.5" size="1.27" layer="98" ratio="10">R02FB = (R01FB * 2.5 * 10^5) / (R01FB - (2.5 * 10^5))  (Ω)
      = (953K * 2.5 * 10^5) / (953K - (2.5 * 10^5))
      = (2382K5 * 10^5) / 703K
      = 338K9</text>
<text x="107.696" y="229.108" size="0.762" layer="98" ratio="10">4V3</text>
<text x="129.54" y="233.68" size="1.27" layer="98" ratio="10">Schottky 40V/1A/400mV</text>
<text x="129.54" y="227.838" size="1.27" layer="98" ratio="10">12uH</text>
<text x="2.54" y="221.488" size="1.27" layer="98" ratio="10">Vmppt = 0.8 * Voc</text>
<text x="65.024" y="164.592" size="1.27" layer="98" ratio="10">factor: x10.0908</text>
<text x="100.584" y="164.592" size="1.27" layer="98" ratio="10">factor: x4.0</text>
<text x="65.024" y="162.052" size="1.27" layer="98" ratio="10">range: 0..33V</text>
<text x="100.584" y="162.052" size="1.27" layer="98" ratio="10">range: 0..13V</text>
</plain>
